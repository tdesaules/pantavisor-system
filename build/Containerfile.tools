# Local packaging/validation tools, not an image deployed on the board.
FROM docker.io/library/ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55 AS tools
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    binutils ca-certificates cpio e2fsprogs git grub-common kmod openssh-client python3 \
    qemu-efi-aarch64 qemu-system-arm qemu-user squashfs-tools tar zstd \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /work
# Extraction must preserve system ownership inside the rootless user namespace.
USER 0:0
ENTRYPOINT ["python3", "-m", "tools.pvbuild"]
LABEL org.opencontainers.image.title="Pantavisor System build tooling" \
      org.opencontainers.image.description="Rootless host-side image packaging and validation tools"
